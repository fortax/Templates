export HISTSIZE=100000
export HISTFILESIZE=100000
export HISTCONTROL=ignorespace:ignoredups
export PROMPT_COMMAND="history -a;"
export HISTIGNORE="clear:ls:mc:exit:date:* --help"

export LS_OPTIONS='--color=auto'
eval "`dircolors`"
alias ls='ls $LS_OPTIONS -al'

alias cat='batcat'
alias catplain='batcat -p'
alias catall='batcat -A'

alias au='apt update && apt upgrade'
alias dl='docker compose logs -f -t --tail 100 | lnav'
alias mc='. /usr/share/mc/bin/mc-wrapper.sh'
alias dc='docker compose'
alias dcu='docker compose up -d'

dcr() {
  docker compose stop "$1"
  docker compose up -d "$1"
}

# Load z.sh if exist
# https://raw.githubusercontent.com/rupa/z/refs/heads/master/z.sh
if test -f ~/z.sh; then
  . ~/z.sh
fi

# THE FANCY PS1

# For Git PS1
source /usr/lib/git-core/git-sh-prompt;
GIT_PS1_SHOWDIRTYSTATE=1
GIT_PS1_SHOWUPSTREAM="verbose"

__mkps1_debian_chroot() {
    # This string is intentionally single-quoted:
    # It will be evaluated when $PS1 is evaluated to generate the prompt each time.
    echo '${debian_chroot:+($debian_chroot)}';
}

__mkps1_inject_exitcode() {
    local code=$1

    if [ "$code" -ne "0" ]; then
        echo " $code "
    fi
}

__mkps1_exitcode() {
    local bg_red=`tput setab 1`;
    local white=`tput setaf 15`;
    local reset=`tput sgr0`;

    # We need to run a function at runtime to evaluate the exitcode.
    echo "\[${bg_red}${white}\]\$(__mkps1_inject_exitcode \$?)\[${reset}\]"
}

__mkps1_time() {
    local BG_GRAY=`tput setab 240`;
    local white=`tput setaf 7`;
    local reset=`tput sgr0`;

    echo "\[${BG_GRAY}${white}\] \t \[${reset}\]"
}

__mkps1_username() {
    local gray=`tput setaf 240`;
    local reset=`tput sgr0`;

    echo "\[${gray}\] \u \[${reset}\]";
}

__mkps1_workdir() {
    local bold=`tput bold`;
    local orange=`tput setaf 172`;
    local reset=`tput sgr0`;

    echo "\[${bold}${orange}\]\w\[${reset}\]";
}

__mkps1_git() {
    local magenta=`tput setaf 213`;
    local reset=`tput sgr0`;

    # Escaping the $ is intentional:
    # This is evaluated when the prompt is generated.
    echo "\$(__git_ps1 ' (\[${magenta}\]%s\[${reset}\])')"
}

__mkps1_user_prompt() {
    local bold=`tput bold`;
    local reset=`tput sgr0`;

    echo "\[${bold}\]\$\[${reset}\] ";
}

__mkps1() {
    local ps1="\n$(__mkps1_debian_chroot)$(__mkps1_exitcode)$(__mkps1_time)$(__mkps1_username)$(__mkps1_workdir)$(__mkps1_git)\n$(__mkps1_us
er_prompt)";

    echo "$ps1";
}

PS1="$(__mkps1)"
